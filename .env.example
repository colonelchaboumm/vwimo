# Copier en .env. Ne jamais versionner de secrets.
IMMO_MODE=demo
IMMO_DATABASE_URL=sqlite:///./.local/demo.db
IMMO_STORAGE_DIR=.local/demo-documents
IMMO_SESSION_HOURS=8
