{
  "name": "immo-pilot-ai",
  "private": true,
  "version": "0.3.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "desktop": "npm run tauri -w apps/desktop -- dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1 && npm run tauri -w apps/desktop -- build",
    "test:e2e": "playwright test",
    "test:native": "node scripts/test-native.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.8.3"
  }
}
